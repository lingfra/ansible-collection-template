---
namespace: {{ namespace }}
name: {{ collection_name }}
version: "{{ version }}"
readme: README.md
authors:
  - lingling <lingling+dev@posteo.de>
description: Template for an Ansible collection.
license_file: "LICENSE"
repository: https://github.com/{{ namespace }}/ansible-collection-{{ namespace }}-{{ collection_name }}
issues: https://github.com/{{ namespace }}/ansible-collection-{{ namespace }}-{{ collection_name }}/issues
documentation: https://github.com/{{ namespace }}/ansible-collection-{{ namespace }}-{{ collection_name }}
tags: []
dependencies: {}
build_ignore:
  - "**/*.ansible"
  - "**/.gitignore"
  - "*.tar.gz"
  - ".aar_doc"
  - ".aar_doc.yml"
  - ".ansible"
  - ".git"
  - ".gitignore"
  - ".gitmodules"
  - "molecule"
