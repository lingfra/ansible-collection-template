#!/usr/bin/sh

mv playbooks/run.yaml playbooks/{{ role | default(collection_name) }}.yaml
mv roles/run roles/{{ role | default(collection_name) }}

git init
git remote add origin git@codeberg.org:lingfra/ansible-collection-{{ namespace }}-{{ collection_name }}.git
git submodule add https://codeberg.org/lingfra/aar-doc-config.git .aar_doc
git add LICENSE README.md CHANGELOG.md galaxy.yml CODE_OF_CONDUCT.md meta/ plugins/ .aar_doc.yml

printf "\n%s\n\n" "---------- git status ----------"
git status

printf "%s\n\n" "---------- git commit ----------"
git commit -m "Initial commit for {{ namespace }}.{{ collection_name }}"

printf "\n%s\n\n" "----------"
printf "Create a repository at https://codeberg.org/lingfra with the name 'ansible-collection-{{ namespace }}-{{ collection_name }}'\n\n"
printf "%s\n\n\t%s\n" "Finish the initialization with" "git push -u origin main"

rm -f init.sh
