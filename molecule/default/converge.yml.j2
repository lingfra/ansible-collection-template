---
- name: Set playbook variables
  hosts: all
  tasks:
    # Connection to podman container is already root and sudo is not available.
    - name: Set ansible_become to false
      ansible.builtin.set_fact:
        ansible_become: false

- name: Import playbook {{ namespace }}.{{ collection_name }}.{{ role | default(collection_name) }}
  ansible.builtin.import_playbook: {{ namespace }}.{{ collection_name }}.{{ role | default(collection_name) }}
